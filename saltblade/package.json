{
  "name": "saltblade",
  "private": true,
  "version": "0.1.0",
  "description": "Saltblade: a squad-based open-world sandbox RPG set in a sundered wasteland.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node tools/checkcss.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "soak": "node tools/soak.mjs",
    "test:sim": "tsx tools/simtest.ts",
    "test:base": "tsx tools/basetest.ts",
    "test:combat": "tsx tools/combattest.ts",
    "test:encounters": "tsx tools/encountertest.ts",
    "test:property": "tsx tools/propertytest.ts",
    "test:build": "tsx tools/buildtest.ts",
    "test:robots": "tsx tools/robottest.ts",
    "test:limbs": "tsx tools/limbtest.ts",
    "test:drugs": "tsx tools/drugtest.ts",
    "test:labels": "tsx tools/labeltest.ts",
    "test:feel": "tsx tools/feeltest.ts",
    "test:captive": "tsx tools/captivetest.ts",
    "test:balance": "tsx tools/balancetest.ts",
    "test:economy": "tsx tools/economytest.ts",
    "test:keys": "tsx tools/keystest.ts",
    "test:saves": "tsx tools/savetest.ts",
    "test:touch": "node tools/touchtest.mjs && node tools/dragtest.mjs",
    "test:render": "tsx tools/qualitytest.ts && node tools/rendertest.mjs",
    "test:contracts": "tsx tools/contracttest.ts",
    "test:stories": "tsx tools/storytest.ts",
    "test:objectives": "tsx tools/objtest.ts",
    "test:travel": "tsx tools/traveltest.ts",
    "test:pace": "tsx tools/pacetest.ts",
    "map": "tsx tools/mapshot.ts",
    "artifact": "node tools/make-artifact.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright": "1.56.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.2"
  }
}
